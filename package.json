{
  "name": "@async/release",
  "version": "0.1.4",
  "description": "Release planning, package inspection, notes rendering, and doctor evidence for Async packages.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/async/release.git"
  },
  "bugs": {
    "url": "https://github.com/async/release/issues"
  },
  "homepage": "https://github.com/async/release#readme",
  "exports": {
    ".": "./src/index.js",
    "./cli": "./src/cli.js"
  },
  "bin": {
    "async-release": "./src/cli.js"
  },
  "scripts": {
    "pack:check": "npm --cache .async/npm-cache pack --dry-run --json --ignore-scripts",
    "release:check": "node --test tests/*.test.js && pnpm run pack:check",
    "test": "node --test tests/*.test.js"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
